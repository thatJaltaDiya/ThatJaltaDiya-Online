# ==============================================================================
# That Jalta Diya Backend Configuration (.env.example)
# ==============================================================================

# Environment
NODE_ENV=production
PORT=5000

# ------------------------------------------------------------------------------
# 1. Database: Neon PostgreSQL
# ------------------------------------------------------------------------------
# DATABASE_URL: Neon pooled connection string (Host contains '-pooler', with sslmode=require&pgbouncer=true)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# DIRECT_URL: Neon direct connection string for migrations (Host does NOT contain '-pooler', with sslmode=require)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# ------------------------------------------------------------------------------
# 2. CORS & Proxy Routing
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (must use HTTPS in production)
CLIENT_ORIGINS="https://your-app.vercel.app"
# Reverse proxy hops behind Cloudflare/Vercel (e.g. 1)
TRUST_PROXY="1"

# ------------------------------------------------------------------------------
# 3. Authentication & Sessions (Argon2id + JWT + Rotating Cookies)
# ------------------------------------------------------------------------------
# In production, JWT secrets MUST be at least 64 random characters (generated via openssl rand -hex 64)
JWT_ACCESS_SECRET="replace_with_at_least_64_random_bytes_super_secure_access_token_secret_here_12345"
JWT_REFRESH_SECRET="replace_with_at_least_64_random_bytes_super_secure_refresh_token_secret_here_67890"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Cookie Secret (at least 32 characters in production)
COOKIE_SECRET="super_secret_cookie_signing_key_at_least_32_chars_long"
# Optional cookie domain for subdomains (e.g. .thatjaltadiya.com)
COOKIE_DOMAIN=""
COOKIE_SAMESITE="lax"

# ------------------------------------------------------------------------------
# 4. Anti-Bot / CAPTCHA (Cloudflare Turnstile)
# ------------------------------------------------------------------------------
# In production, get this from Cloudflare Dashboard > Turnstile
TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"
# Optional comma-separated hostnames allowed by Turnstile (e.g. your-app.vercel.app,thatjaltadiya.com)
TURNSTILE_ALLOWED_HOSTNAMES=""
# Test bypass flag (MUST be false in production; startup refuses if true in prod)
ALLOW_TEST_CAPTCHA="false"

# ------------------------------------------------------------------------------
# 5. Image Storage: Neon Object Storage (S3-Compatible)
# ------------------------------------------------------------------------------
# In development, leave blank to use LocalStorageAdapter (backend/uploads-dev/)
# In production, all STORAGE_* variables are strictly required
STORAGE_ENDPOINT="https://br-your-branch.storage.ap-southeast-1.aws.neon.tech"
STORAGE_REGION="ap-southeast-1"
STORAGE_ACCESS_KEY_ID="your_neon_storage_access_key_id"
STORAGE_SECRET_ACCESS_KEY="your_neon_storage_secret_access_key"
STORAGE_BUCKET="uploads"
STORAGE_PUBLIC_BASE_URL="https://br-your-branch.storage.ap-southeast-1.aws.neon.tech/uploads"
STORAGE_FORCE_PATH_STYLE="true"

# ------------------------------------------------------------------------------
# 6. Payments: Razorpay
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID="rzp_live_or_test_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# ------------------------------------------------------------------------------
# 7. Orders, Inventory & Abandoned Order Expiry
# ------------------------------------------------------------------------------
# Developer test mode for placing unpaid test orders (MUST be false in production)
ALLOW_UNPAID_TEST_ORDERS="false"
# Automated cleanup for unpaid orders to restock inventory
ENABLE_UNPAID_ORDER_EXPIRY="true"
UNPAID_ORDER_EXPIRY_MINUTES="30"

# ------------------------------------------------------------------------------
# 8. Transactional Email (SMTP or Resend)
# ------------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
RESEND_API_KEY=""
EMAIL_FROM="That Jalta Diya <hello@thatjaltadiya.com>"

# ------------------------------------------------------------------------------
# 9. Admin Credentials & Observability
# ------------------------------------------------------------------------------
ADMIN_EMAIL="admin@thatjaltadiya.com"
ADMIN_PASSWORD="Admin@ThatJaltaDiya2026!"
ADMIN_2FA_APP_NAME="That Jalta Diya"
SENTRY_DSN=""
