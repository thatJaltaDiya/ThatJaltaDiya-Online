// Prisma schema for That Jalta Diya e-commerce platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  REFUND_REQUIRED
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

model User {
  id                    String                   @id @default(uuid())
  email                 String                   @unique
  passwordHash          String
  name                  String
  phone                 String?
  role                  Role                     @default(CUSTOMER)
  isEmailVerified       Boolean                  @default(false)
  isPhoneVerified       Boolean                  @default(false)
  isBlocked             Boolean                  @default(false)
  isDeleted             Boolean                  @default(false)
  failedLoginAttempts   Int                      @default(0)
  lockUntil             DateTime?
  twoFactorSecret       String?
  twoFactorEnabled      Boolean                  @default(false)
  twoFactorBackupCodes  String[]                 @default([])
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  addresses             Address[]
  orders                Order[]
  cart                  Cart?
  wishlist              Wishlist?
  refreshTokens         RefreshToken[]
  emailTokens           EmailVerificationToken[]
  passwordResetTokens   PasswordResetToken[]
  auditLogs             AuditLog[]
  couponRedemptions     CouponRedemption[]

  @@index([email])
  @@index([role])
}

model Address {
  id            String   @id @default(uuid())
  userId        String
  recipientName String
  phone         String
  street        String
  apartment     String?
  city          String
  state         String
  postalCode    String
  country       String   @default("IN")
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  isDemo      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]

  @@index([slug])
  @@index([isDemo])
}

model Product {
  id                 String           @id @default(uuid())
  name               String
  slug               String           @unique
  description        String
  shortDescription   String?
  price              Int              // in paise (e.g. 99900 = INR 999.00)
  compareAtPrice     Int?             // in paise
  costPrice          Int?             // in paise
  sku                String           @unique
  stock              Int              @default(0)
  isLowStockAlert    Boolean          @default(true)
  lowStockThreshold  Int              @default(5)
  isActive           Boolean          @default(true)
  isFeatured         Boolean          @default(false)
  isBestseller       Boolean          @default(false)
  isNew              Boolean          @default(false)
  isDemo             Boolean          @default(false)
  metaTitle          String?
  metaDescription    String?
  categoryId         String
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  deletedAt          DateTime?        // soft delete

  category           Category         @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  variants           ProductVariant[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  stockLogs          StockLog[]

  @@index([slug])
  @@index([categoryId])
  @@index([isActive, deletedAt])
  @@index([isFeatured])
  @@index([isBestseller])
  @@index([isDemo])
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  url        String
  storageKey String?
  altText    String?
  sortOrder  Int      @default(0)
  isPrimary  Boolean  @default(false)
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isDemo])
}

model ProductVariant {
  id        String      @id @default(uuid())
  productId String
  name      String
  sku       String      @unique
  price     Int         // in paise
  stock     Int         @default(0)
  options   Json        // e.g. { "scent": "Vanilla Rose", "size": "Standard" }
  isDemo    Boolean     @default(false)
  createdAt DateTime    @default(now())

  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems CartItem[]
  orderItems OrderItem[]
  stockLogs StockLog[]

  @@index([productId])
  @@index([sku])
}

model Cart {
  id        String     @id @default(uuid())
  userId    String?    @unique
  guestId   String?    @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]

  @@index([userId])
  @@index([guestId])
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]

  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())

  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@index([wishlistId])
}

model Order {
  id             String        @id @default(uuid())
  orderNumber    String        @unique
  userId         String
  idempotencyKey String        @unique
  status         OrderStatus   @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  paymentMethod  String        @default("TEST") // "CARD", "UPI", "COD", "TEST", "RAZORPAY"
  paymentId      String?
  razorpayOrderId String?
  subtotal       Int           // in paise
  discount       Int           @default(0) // in paise
  shippingFee    Int           @default(0) // in paise
  total          Int           // in paise
  couponCode     String?
  notes          String?
  giftMessage    String?
  shippingAddress Json         // Snapshot of address object
  trackingNumber String?
  courier        String?
  internalNotes  String?
  paymentExpiresAt DateTime?
  ipAddress      String?
  userAgent      String?
  isDemo         Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           User          @relation(fields: [userId], references: [id])
  items          OrderItem[]
  payments       Payment[]
  couponRedemptions CouponRedemption[]

  @@index([userId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@index([isDemo])
  @@index([status, paymentExpiresAt])
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  transactionId   String?
  razorpayOrderId String?
  amount          Int
  currency        String        @default("INR")
  status          PaymentStatus @default(PENDING)
  gateway         String        @default("razorpay")
  payload         Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([transactionId])
  @@index([razorpayOrderId])
  @@map("payments")
}

model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  productId       String?
  variantId       String?
  productName     String          // snapshot
  productSku      String          // snapshot
  price           Int             // in paise (snapshot)
  quantity        Int
  image           String?         // snapshot
  selectedOptions Json?           // snapshot

  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model Coupon {
  id            String             @id @default(uuid())
  code          String             @unique
  description   String?
  discountType  DiscountType       @default(PERCENTAGE)
  discountValue Int                // percentage (e.g. 15 for 15%) or flat amount in paise
  minOrderValue Int                @default(0) // in paise
  maxDiscount   Int?               // in paise (optional ceiling for % discounts)
  startsAt      DateTime?
  expiresAt     DateTime?
  usageLimit    Int?               // max total times this coupon can be used
  usageCount    Int                @default(0)
  perUserLimit  Int                @default(1)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())

  redemptions   CouponRedemption[]

  @@index([code])
  @@index([isActive])
}

model CouponRedemption {
  id        String   @id @default(uuid())
  couponId  String
  userId    String
  orderId   String
  createdAt DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@index([userId])
}

model StockLog {
  id        String          @id @default(uuid())
  productId String
  variantId String?
  change    Int             // positive for restock, negative for deduction
  reason    String          // e.g. "ORDER_CREATED", "ORDER_CANCELLED", "MANUAL_ADJUSTMENT"
  note      String?
  adminId   String?
  createdAt DateTime        @default(now())

  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
}

model ContactMessage {
  id         String   @id @default(uuid())
  name       String
  email      String
  subject    String?
  message    String
  isRead     Boolean  @default(false)
  isArchived Boolean  @default(false)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model Testimonial {
  id         String   @id @default(uuid())
  author     String
  rating     Int      @default(5)
  reviewText String
  location   String?
  isApproved Boolean  @default(true)
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([isApproved])
  @@index([isDemo])
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  family    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@index([family])
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
}

model OtpRequest {
  id         String   @id @default(uuid())
  identifier String   // phone number or email address
  purpose    String   // "EMAIL_CHANGE", "LOGIN"
  codeHash   String   // argon2/bcrypt hash of 6-digit OTP
  attempts   Int      @default(0)
  expiresAt  DateTime
  isVerified Boolean  @default(false)
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([identifier, purpose])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  action     String   // e.g. "PRODUCT_CREATE", "STOCK_ADJUST", "DEMO_DATA_CLEANUP"
  targetType String   // e.g. "Product", "Order", "Coupon"
  targetId   String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  admin      User?    @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  isPublic  Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@index([key])
}
