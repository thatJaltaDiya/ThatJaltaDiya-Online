# Server Environment Configuration
NODE_ENV=development
PORT=5000

# Database (Supabase PostgreSQL or Local)
# In production with Supabase:
# DATABASE_URL: connection pooling URL (Transaction mode, port 6543)
# DIRECT_URL: direct connection URL (Session mode, port 5432) for migrations
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/thatjaltadiya?schema=public"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:5432/thatjaltadiya?schema=public"

# Frontend Client Origin (comma-separated allowlist)
CLIENT_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# JWT Authentication
# Must be at least 64 random bytes in production
JWT_ACCESS_SECRET="replace_with_at_least_64_random_bytes_super_secure_access_token_secret_here_12345"
JWT_REFRESH_SECRET="replace_with_at_least_64_random_bytes_super_secure_refresh_token_secret_here_67890"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Cookie Signing
COOKIE_SECRET="super_secret_cookie_signing_key_at_least_32_chars_long"

# Cloudflare Turnstile (Anti-Spam / CAPTCHA)
# Dev dummy key provided by Cloudflare: 1x0000000000000000000000000000000AA (always passes)
CLOUDFLARE_TURNSTILE_SECRET_KEY="1x0000000000000000000000000000000AA"

# Supabase Storage (for product images)
# If empty in development, uploads fall back to server/uploads-dev/ (disabled in production)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="product-images"

# Payment Gateway dev testing
# MUST be false or unset in production (server will refuse to boot in production if true)
ALLOW_UNPAID_TEST_ORDERS="true"

# Email Delivery (Nodemailer / SMTP or Resend)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="That Jalta Diya <hello@thatjaltadiya.com>"
