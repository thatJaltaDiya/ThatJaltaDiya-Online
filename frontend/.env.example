# Frontend Production Environment Configuration (.env.example)
# When deploying frontend & backend together via root vercel.json, keep "/api/v1"
VITE_API_URL="/api/v1"

# Cloudflare Turnstile Public Site Key (Get from Cloudflare Dashboard > Turnstile)
# NOTE: Production builds will REFUSE to build with the Cloudflare dummy test key
# unless ALLOW_TEST_KEYS=true is set in the build environment.
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAxxxxxxxxxxxxxxx"
